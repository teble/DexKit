set(DEXKIT_SMALI_SIZE_PROBE "none" CACHE STRING "Experimental smali body: none, ir, light")
set_property(CACHE DEXKIT_SMALI_SIZE_PROBE PROPERTY STRINGS none ir light)
if (NOT DEXKIT_SMALI_SIZE_PROBE STREQUAL "none")
    if (DEXKIT_SMALI_SIZE_PROBE STREQUAL "ir")
        target_compile_definitions(dexkit PRIVATE DEXKIT_SMALI_PROBE_IR=1)
    elseif (DEXKIT_SMALI_SIZE_PROBE STREQUAL "light")
        target_compile_definitions(dexkit PRIVATE DEXKIT_SMALI_PROBE_IR=0)
    else ()
        message(FATAL_ERROR "Unknown DEXKIT_SMALI_SIZE_PROBE")
    endif ()
    target_sources(dexkit PRIVATE "${CMAKE_CURRENT_LIST_DIR}/smali_size_probe.cpp")
endif ()
